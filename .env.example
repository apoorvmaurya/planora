# ── Supabase Configuration ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# ── AI Engine (Groq) ──
GROQ_API_KEY=gsk_your_groq_api_key_placeholder

# ── Geocoding & Transit (LocationIQ) ──
LOCATIONIQ_KEY=pk.your_locationiq_api_key_placeholder

# ── Transactional Email (Resend) ──
RESEND_API_KEY=re_your_resend_api_key_placeholder

# ── App URL ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Web Push Notifications (VAPID) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_placeholder
VAPID_PRIVATE_KEY=your_vapid_private_key_placeholder
