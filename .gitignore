# ────────────────────────────────────────────────────────────────────────
# PLANORA REPOSITORY CONFIGURATION: GIT IGNORE PATTERNS
# ────────────────────────────────────────────────────────────────────────

# ── Dependency Managers ──
node_modules/
.npm/
.pnpm-store/
jspm_packages/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build & production outputs ──
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ── Vercel Integration ──
.vercel/

# ── Testing & Code Coverage ──
coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/
playwright-report/
test-results/

# ── Environment & Secrets (Never commit credentials) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key

# ── Supabase Local Engine ──
supabase/.temp/
supabase/.branches/
supabase/.env.local
supabase/.env.keys
.env.keys

# ── Workspace Caches & Linters ──
.eslintcache
.parcel-cache
.cache/
.npm-global/

# ── IDEs & Code Editors ──
.idea/
.vscode/*
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ── System Files ──
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Icon?

# ── AI Agent Tooling & Metadata ──
.agents/
skills-lock.json

# ── Local Developer Sandboxes & Log Output ──
scratch/
temp/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*